                                    <Button Content="Apri terminale Ubuntu" Click="LaunchUbuntu_Click" x:Name="L10n0154"/>
                                </StackPanel>
                                <TextBlock x:Name="WslStatusText" Text="Non verificato: esegui il controllo su richiesta." Foreground="{StaticResource AstraDeepText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="11">
                                <TextBlock Text="PACCHETTI E TOOLCHAIN UBUNTU" FontSize="18" FontWeight="SemiBold" x:Name="L10n0155"/>
                                <TextBlock Text="Comandi da eseguire manualmente nel terminale Ubuntu, dopo aver valutato i pacchetti. Non usiamo sudo nascosto o repository non ufficiali." Foreground="{StaticResource AstraDeepText}" TextWrapping="Wrap" x:Name="L10n0156"/>
                                <Button Content="Copia comando aggiornamenti APT" Click="CopyAptUpdate_Click" HorizontalAlignment="Left" x:Name="L10n0157"/>
                                <Button Content="Copia toolchain STEM (Python, Git, compilatori)" Click="CopyStemApt_Click" HorizontalAlignment="Left" x:Name="L10n0158"/>
                                <Button Content="Apri le istruzioni ufficiali WSL" Click="OpenWslGuide_Click" HorizontalAlignment="Left" x:Name="L10n0159"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="SICUREZZA / SEPARAZIONE AMBIENTI" FontSize="18" FontWeight="SemiBold" x:Name="L10n0160"/>
                                <TextBlock Text="• Non eseguire script scaricati con pipe in Bash. • Proteggi le chiavi SSH e usa sorgenti APT attendibili. • Non montare automaticamente cartelle riservate in ambienti non attendibili. • WSL richiede virtualizzazione ed eventualmente un riavvio. • I processi Linux consumano risorse solo quando avviati, salvo servizi avviati dalla distribuzione." TextWrapping="Wrap" Foreground="{StaticResource AstraDeepText}" x:Name="L10n0161"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="IsoPanel" Spacing="14" Visibility="Collapsed">
