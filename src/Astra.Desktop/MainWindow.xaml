       <Border Background="{StaticResource AstraBlue}" Width="42" Height="42" CornerRadius="12" VerticalAlignment="Top"><SymbolIcon Symbol="Message" Foreground="{StaticResource AstraTextLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="ASTRA Assistant" FontWeight="SemiBold" FontSize="17" x:Name="L10n0046"/><TextBlock Text="Organizza. Ricorda. Cresci." FontSize="12" TextWrapping="Wrap" x:Name="L10n0047"/><TextBlock Text="Note cifrate e AI locale." FontSize="11" TextWrapping="Wrap" Opacity="0.75" x:Name="L10n0048"/></StackPanel>
       <SymbolIcon Grid.Column="2" Symbol="Forward" Opacity="0.7"/></Grid></Button></Border><Border Grid.Row="1" Grid.Column="2"><Button Style="{StaticResource V4CardButton}" Click="UbuntuNav_Click" AutomationProperties.Name="Apri Ubuntu Lab" x:Name="L10n0049">
       <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Background="{StaticResource AstraBlue}" Width="42" Height="42" CornerRadius="12" VerticalAlignment="Top"><SymbolIcon Symbol="Library" Foreground="{StaticResource AstraTextLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Ubuntu Lab" FontWeight="SemiBold" FontSize="17" x:Name="L10n0050"/><TextBlock Text="Linux. Sviluppa. Esplora." FontSize="12" TextWrapping="Wrap" x:Name="L10n0051"/><TextBlock Text="WSL opzionale, terminale Ubuntu." FontSize="11" TextWrapping="Wrap" Opacity="0.75" x:Name="L10n0052"/></StackPanel>
       <SymbolIcon Grid.Column="2" Symbol="Forward" Opacity="0.7"/></Grid></Button></Border></Grid>
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0"><Button Style="{StaticResource V4DarkCardButton}" Click="SecurityNav_Click" AutomationProperties.Name="Apri Security Center" x:Name="L10n0053">
       <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Background="{StaticResource AstraBlue}" Width="42" Height="42" CornerRadius="12" VerticalAlignment="Top"><SymbolIcon Symbol="ProtectedDocument" Foreground="{StaticResource AstraTextLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Security Center" FontWeight="SemiBold" FontSize="17" x:Name="L10n0054"/><TextBlock Text="Proteggi il tuo sistema." FontSize="12" TextWrapping="Wrap" x:Name="L10n0055"/><TextBlock Text="Controlli Windows reali, non simulati." FontSize="11" TextWrapping="Wrap" Opacity="0.75" x:Name="L10n0056"/></StackPanel>
       <SymbolIcon Grid.Column="2" Symbol="Forward" Opacity="0.7"/></Grid></Button></Border>
     <Border Grid.Column="1"><Button Style="{StaticResource V4DarkCardButton}" Click="OrbitNav_Click" AutomationProperties.Name="Apri Orbital 3D" x:Name="L10n0057">
       <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Background="{StaticResource AstraBlue}" Width="42" Height="42" CornerRadius="12" VerticalAlignment="Top"><SymbolIcon Symbol="Globe" Foreground="{StaticResource AstraTextLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Orbital 3D" FontWeight="SemiBold" FontSize="17" x:Name="L10n0058"/><TextBlock Text="Visualizza. Esplora." FontSize="12" TextWrapping="Wrap" x:Name="L10n0059"/><TextBlock Text="Scena GPU su richiesta." FontSize="11" TextWrapping="Wrap" Opacity="0.75" x:Name="L10n0060"/></StackPanel>
       <SymbolIcon Grid.Column="2" Symbol="Forward" Opacity="0.7"/></Grid></Button></Border>
   </Grid>
  </StackPanel>
  <StackPanel x:Name="DashboardWidgets" Grid.Column="1" Spacing="12">
    <Border Background="{StaticResource AstraDeep}" CornerRadius="18" Padding="16" BorderBrush="{StaticResource AstraBlue}" BorderThickness="1">
