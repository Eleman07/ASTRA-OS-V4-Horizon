<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="UbuntuPanel" Spacing="16" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="UBUNTU LAB / WSL 2" FontSize="22" FontWeight="SemiBold" x:Name="L10n0150"/>
                                <TextBlock Text="Ambiente Linux reale e opzionale dentro Windows. Puoi usare Bash, APT e la toolchain Ubuntu; nessun kernel Windows viene sostituito." TextWrapping="Wrap" Foreground="{StaticResource AstraDeepText}" x:Name="L10n0151"/>
                                <Border Background="{StaticResource AstraDeep}" Padding="12" CornerRadius="10">
                                    <TextBlock Text="Non trasferisce le protezioni Ubuntu a Windows. Defender, Firewall, Windows Update e sicurezza del kernel rimangono gestiti da Microsoft." TextWrapping="Wrap" Foreground="{StaticResource AstraDeepText}" x:Name="L10n0152"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="WslScanButton" Content="Verifica WSL/Ubuntu" Click="WslScan_Click" Style="{StaticResource PrimaryButton}"/>
