       <SymbolIcon Grid.Column="2" Symbol="Forward" Opacity="0.7"/></Grid></Button></Border><Border Grid.Row="0" Grid.Column="2"><Button Style="{StaticResource V4CardButton}" Tag="creator" Click="WorkspaceNav_Click" AutomationProperties.Name="Apri Creator" x:Name="L10n0037">
       <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Background="{StaticResource AstraBlue}" Width="42" Height="42" CornerRadius="12" VerticalAlignment="Top"><SymbolIcon Symbol="Edit" Foreground="{StaticResource AstraTextLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Creator" FontWeight="SemiBold" FontSize="17" x:Name="L10n0038"/><TextBlock Text="Progetta. Crea. Produci." FontSize="12" TextWrapping="Wrap" x:Name="L10n0039"/><TextBlock Text="Software professionali e creatività." FontSize="11" TextWrapping="Wrap" Opacity="0.75" x:Name="L10n0040"/></StackPanel>
       <SymbolIcon Grid.Column="2" Symbol="Forward" Opacity="0.7"/></Grid></Button></Border><Border Grid.Row="1" Grid.Column="0"><Button Style="{StaticResource V4CardButton}" Tag="gaming" Click="WorkspaceNav_Click" AutomationProperties.Name="Apri Gaming" x:Name="L10n0041">
       <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Background="{StaticResource AstraBlue}" Width="42" Height="42" CornerRadius="12" VerticalAlignment="Top"><SymbolIcon Symbol="Shop" Foreground="{StaticResource AstraTextLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Gaming" FontWeight="SemiBold" FontSize="17" x:Name="L10n0042"/><TextBlock Text="Gioca e organizza." FontSize="12" TextWrapping="Wrap" x:Name="L10n0043"/><TextBlock Text="Launcher e prestazioni, senza rischi." FontSize="11" TextWrapping="Wrap" Opacity="0.75" x:Name="L10n0044"/></StackPanel>
       <SymbolIcon Grid.Column="2" Symbol="Forward" Opacity="0.7"/></Grid></Button></Border><Border Grid.Row="1" Grid.Column="1"><Button Style="{StaticResource V4DarkCardButton}" Click="BrainNav_Click" AutomationProperties.Name="Apri Second Brain" x:Name="L10n0045">
