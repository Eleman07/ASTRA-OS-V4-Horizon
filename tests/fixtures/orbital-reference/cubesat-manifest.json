    "propagator": "orbital.py",
    "plotter": "plots.py",
    "tests": "tests/test_orbit.py",
    "dependencies": "requirements.txt",
    "trajectory": "results/trajectory.csv",
    "trajectoryHalfStep": "results/trajectory-half-step.csv",
    "metrics": "results/metrics.json",
    "testResults": "results/test-results.json",
    "plots": ["results/orbit.svg", "results/energy.svg"],
    "notes": ["obsidian/Progetto CubeSat 400 km.md", "obsidian/Metodo e ipotesi.md", "obsidian/Risultati e verifiche.md"]
