{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASTRA Assistant skill v1",
  "description": "Canonical exported JSON. Capabilities describe intent and never grant execution or file-write permission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "Id", "Name", "Description", "Category", "Instructions", "Capabilities"],
  "properties": {
    "SchemaVersion": {"const": 1},
    "Id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,79}$"},
    "Name": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "Description": {"type": "string", "maxLength": 600},
    "Category": {"type": "string", "maxLength": 50},
    "Instructions": {"type": "string", "minLength": 1},
    "Capabilities": {
      "type": "array", "maxItems": 12,
      "items": {"enum": ["chat", "memory", "web.search", "web.read", "project.read", "project.propose", "project.apply", "process.run", "study", "stem", "creator", "gaming"]}
    },
    "PreferredTask": {"type": "integer", "minimum": 0, "maximum": 8, "default": 0}
  }
}
